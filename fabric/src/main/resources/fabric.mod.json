{
  "schemaVersion": 1,
  "id": "multiclicker",
  "version": "${version}",
  "name": "MultiClicker",
  "description": "Configurable client-side auto clicker with helpers for AFK farms, mining and fishing: attack/use/jump channels, target filter, safety stop, smart offhand, auto eat, auto potion, auto farm, auto fish, hotbar refill, inventory cleaner, auto walk, anti-AFK, auto reconnect, goals, HUD, profiles and statistics.",
  "authors": [
    "Shamanalle"
  ],
  "contact": {
    "sources": "https://github.com/Shamanalle/MultiClicker",
    "issues": "https://github.com/Shamanalle/MultiClicker/issues"
  },
  "license": "MIT",
  "icon": "assets/multiclicker/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "io.github.shamanalle.multiclicker.fabric.MultiClickerFabric"
    ],
    "modmenu": [
      "io.github.shamanalle.multiclicker.fabric.ModMenuIntegration"
    ]
  },
  "mixins": [
    "multiclicker.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_min}",
    "${fabric_api_id}": "*",
    "minecraft": "${minecraft_range}",
    "java": ">=${java_version}"
  },
  "suggests": {
    "modmenu": "*"
  }
}
