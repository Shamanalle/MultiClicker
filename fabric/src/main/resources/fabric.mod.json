{
  "schemaVersion": 1,
  "id": "multiclicker",
  "version": "${version}",
  "name": "MultiClicker",
  "description": "Configurable auto clicker with helpers for AFK farms, mining and fishing: attack/use/jump channels, target filter, auto eat, smart offhand, auto fish, anti-AFK, HUD and a modern settings menu.",
  "authors": [
    "Multi Clicker Team"
  ],
  "contact": {
    "sources": "https://github.com/Shamanalle/MultiClicker",
    "issues": "https://github.com/Shamanalle/MultiClicker/issues"
  },
  "license": "MIT",
  "icon": "assets/multiclicker/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "io.github.shamanalle.multiclicker.fabric.MultiClickerFabric"
    ],
    "modmenu": [
      "io.github.shamanalle.multiclicker.fabric.ModMenuIntegration"
    ]
  },
  "mixins": [
    "multiclicker.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_min}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}"
  },
  "suggests": {
    "modmenu": "*"
  }
}
